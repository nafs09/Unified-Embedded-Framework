# Architecture and platform are independent axes. Board presets are not backends.
# UETD_TARGET is retained as a compatibility input for existing host/Cortex-M users.
set(UETD_TARGET "HOST" CACHE STRING "Legacy UHAL target alias: HOST or CORTEX_M")
set_property(CACHE UETD_TARGET PROPERTY STRINGS HOST CORTEX_M)
set(UETD_ARCH "" CACHE STRING "CPU architecture: HOST, CORTEX_M, AVR, XTENSA or RISCV; empty uses legacy UETD_TARGET")
set_property(CACHE UETD_ARCH PROPERTY STRINGS HOST CORTEX_M AVR XTENSA RISCV)
if(NOT UETD_ARCH)
  set(UETD_ARCH "${UETD_TARGET}")
elseif(NOT UETD_TARGET STREQUAL "HOST" AND NOT UETD_TARGET STREQUAL UETD_ARCH)
  message(FATAL_ERROR "Conflicting UETD_TARGET='${UETD_TARGET}' and UETD_ARCH='${UETD_ARCH}'")
endif()
if(UETD_ARCH STREQUAL "HOST")
  set(_uetd_default_platform HOST)
else()
  set(_uetd_default_platform CUSTOM)
endif()
set(UETD_PLATFORM "" CACHE STRING "SoC/SDK platform implementation; empty selects HOST or CUSTOM")
if(NOT UETD_PLATFORM)
  set(UETD_PLATFORM "${_uetd_default_platform}")
endif()
set(UETD_UHAL_PLATFORM_SOURCES "" CACHE STRING "Exact platform sources for clocks, GPIO, memory and monotonic time")
set(UETD_UHAL_PLATFORM_DEFINITIONS "" CACHE STRING "Verified chip/platform capability definitions")
set(UETD_CMSIS_INCLUDE_DIR "" CACHE STRING "CMSIS core/device include directories for Cortex-M")
set(UETD_CMSIS_DEVICE_HEADER "" CACHE STRING "Exact CMSIS device header")

if(UETD_ARCH STREQUAL "HOST" AND UETD_PLATFORM STREQUAL "HOST")
  file(GLOB UETD_UHAL_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/platform/host/*.c")
  set(UETD_TARGET_DEFINITIONS UHAL_HOST_SIMULATION=1 UETD_ARCH_HOST=1)
elseif(UETD_ARCH STREQUAL "CORTEX_M" AND UETD_PLATFORM STREQUAL "CUSTOM")
  if(NOT UETD_CMSIS_INCLUDE_DIR OR NOT UETD_CMSIS_DEVICE_HEADER)
    message(FATAL_ERROR "CORTEX_M requires exact UETD_CMSIS_INCLUDE_DIR and UETD_CMSIS_DEVICE_HEADER")
  endif()
  if(NOT UETD_UHAL_PLATFORM_SOURCES)
    message(FATAL_ERROR
      "Cortex-M specifies CPU operations only. Supply UETD_UHAL_PLATFORM_SOURCES for the exact "
      "SoC/platform (clocks, GPIO, memory, uetd_time_now_us/delays, CPU frequency and extended "
      "cycle policy). A development board is optional. Generic peripheral TODOs are not a hardware port.")
  endif()
  foreach(_source IN LISTS UETD_UHAL_PLATFORM_SOURCES)
    if(NOT IS_ABSOLUTE "${_source}" OR NOT EXISTS "${_source}" OR IS_DIRECTORY "${_source}")
      message(FATAL_ERROR "Missing UHAL platform source: ${_source}; use absolute source paths")
    endif()
    if(_source MATCHES "cortex_m_scaffold")
      message(FATAL_ERROR "cortex_m_scaffold contains unimplemented operations, not a platform")
    endif()
  endforeach()
  file(GLOB UETD_UHAL_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/arch/cortex_m/*.c")
  list(APPEND UETD_UHAL_SOURCES ${UETD_UHAL_PLATFORM_SOURCES})
  set(UETD_TARGET_DEFINITIONS UETD_TARGET_CORTEX_M=1 UETD_ARCH_CORTEX_M=1
    UETD_CMSIS_DEVICE_HEADER=\"${UETD_CMSIS_DEVICE_HEADER}\")
else()
  message(FATAL_ERROR
    "No complete UHAL composition for architecture '${UETD_ARCH}' and platform '${UETD_PLATFORM}'. "
    "AVR and ESP-IDF remain development work areas; unsupported hardware never selects HOST.")
endif()
list(APPEND UETD_TARGET_DEFINITIONS ${UETD_UHAL_PLATFORM_DEFINITIONS})
