  "ucon_api": {
    "status_header": "ucon/status.h",
    "scaffold_header": "ucon/detail/algorithm_call.h",
    "scaffold_tree": {
      "initial_headers_root": "include/ucon",
      "initial_sources_root": "src/ucon",
      "future_headers_root": "include/ucon/future",
      "future_sources_root": "src/ucon/future",
      "one_algorithm_per_header_and_source": true,
      "future_policy": "Unselected PLANNED and all DEFERRED entries are repository-only and not selectable by uef-gen",
      "initial_planned_algorithms": [
        "ADAPTIVE_BS",
        "BACKSTEPPING",
        "BESSEL",
        "BEZIER_TRAJ",
        "BSPLINE_TRAJ",
        "BUTTERWORTH",
        "CBF_QP",
        "CHEBYSHEV1",
        "CHEBYSHEV2",
        "CKF",
        "CLF_CBF",
        "CLF_QP",
        "DDP",
        "DEADBEAT_MPC",
        "ECONOMIC_MPC",
        "ELLIPTIC",
        "EXTREMUM_SEEK",
        "FEEDBACK_LIN",
        "FIR_WINDOWED",
        "FLATNESS",
        "ILQR",
        "INDI2",
        "ITERATED_EKF",
        "MHE",
        "PARTICLE",
        "PID_AUTOTUNE",
        "PKPD_TARGET_CONTROL",
        "REFERENCE_GOVERNOR",
        "ROBUST_MPC",
        "SPARSE_MPC",
        "SQRT_EKF",
        "SQRT_UKF",
        "STOCHASTIC_MPC",
        "ZONE_MPC"
      ]
    },
    "registered_algorithms": {
      "PID": {
        "header": "ucon/control/classical/pid.h",
        "functions": [
          "ucon_pid_init",
          "ucon_pid_reset",
          "ucon_pid_step"
        ]
      },
      "LEAD_LAG": {
        "header": "ucon/control/classical/lead_lag.h",
        "functions": [
          "ucon_lead_lag_init",
          "ucon_lead_lag_reset",
          "ucon_lead_lag_step"
        ]
      }
    },
    "unregistered_policy": "Scaffold functions return UCON_NOT_IMPLEMENTED and never alter state or output buffers.",
    "per_algorithm_operation_functions": true,
    "operation_todos_are_function_scoped": true
  },
