set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR "{{ processor }}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(CMAKE_C_COMPILER NAMES {{ c_compiler_name }} REQUIRED)
find_program(CMAKE_ASM_COMPILER NAMES {{ asm_compiler_name }} REQUIRED)
find_program(CMAKE_OBJCOPY NAMES {{ objcopy_name }} REQUIRED)
find_program(CMAKE_SIZE NAMES {{ size_name }} REQUIRED)

set(CMAKE_C_FLAGS_INIT "{{ c_flags }}")
set(CMAKE_ASM_FLAGS_INIT "{{ asm_flags }}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "{{ linker_flags }}")
