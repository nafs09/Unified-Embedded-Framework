.syntax unified
.cpu {{ cpu }}
.thumb

.section .isr_vector,"a",%progbits
.balign {{ vector_alignment_bytes }}
.global g_pfnVectors
.type g_pfnVectors,%object
g_pfnVectors:
    .word _estack
    .word Reset_Handler
{% for vector in vectors %}{% if vector %}    .word {{ vector }}
{% else %}    .word 0
{% endif %}{% endfor %}.size g_pfnVectors, .-g_pfnVectors

{% for handler in weak_handlers %}{% if handler != "Default_Handler" and handler != "Reset_Handler" %}.weak {{ handler }}
.thumb_set {{ handler }}, Default_Handler
{% endif %}{% endfor %}
.weak Default_Handler
.type Default_Handler,%function
.thumb_func
Default_Handler:
    b .

.section .text.Reset_Handler,"ax",%progbits
.global Reset_Handler
.type Reset_Handler,%function
.thumb_func
Reset_Handler:
    bl {{ system_init_symbol }}
    ldr r0, =_sidata
    ldr r1, =_sdata
    ldr r2, =_edata
.Lcopy_data:
    cmp r1, r2
    bcs .Lzero_bss_start
    ldr r3, [r0]
    str r3, [r1]
    adds r0, r0, #4
    adds r1, r1, #4
    b .Lcopy_data
.Lzero_bss_start:
    ldr r1, =_sbss
    ldr r2, =_ebss
    movs r3, #0
.Lzero_bss:
    cmp r1, r2
    bcs .Lruntime_init
    str r3, [r1]
    adds r1, r1, #4
    b .Lzero_bss
.Lruntime_init:
{% if runtime_init_symbol %}    bl {{ runtime_init_symbol }}
{% endif %}    bl {{ main_symbol }}
.Lhalt:
    b .Lhalt
.size Reset_Handler, .-Reset_Handler
