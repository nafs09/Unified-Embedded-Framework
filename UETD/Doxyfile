# Generate through UETD/tools/generate_api_docs.ps1 or the uetd-api-docs CMake target.

PROJECT_NAME           = "UETD API"
PROJECT_BRIEF          = "Public C11 APIs for the Unified Embedded Template Directory"
PROJECT_NUMBER         = 1.1.0

OUTPUT_DIRECTORY       = build/UETD/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

INPUT                  = UETD/include
FILE_PATTERNS          = *.h
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8
SEARCH_INCLUDES        = NO
EXCLUDE_PATTERNS       = */third_party/*
EXCLUDE                = UETD/include/uhal/target_config.h

# Enable all target-gated public APIs so the reference covers each capability.
PREDEFINED             = UHAL_HAS_DCACHE=1 \
                         UHAL_HAS_SDMMC=1 \
                         UHAL_HAS_CORDIC=1 \
                         UHAL_HAS_FMAC=1

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF       = YES
MARKDOWN_SUPPORT        = YES
ENABLE_PREPROCESSING   = YES
EXTRACT_ALL             = YES
EXTRACT_STATIC          = YES
HIDE_UNDOC_MEMBERS      = NO

WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = NO
WARN_AS_ERROR           = NO
WARN_FORMAT             = "$file:$line: $text"
WARN_LOGFILE            = build/UETD/doxygen/warnings.log

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
GENERATE_XML            = YES
XML_OUTPUT              = xml
GENERATE_LATEX          = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_HTMLHELP       = NO
