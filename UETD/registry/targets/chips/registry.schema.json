{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uetd/registry/targets/chips/registry.schema.json",
  "title": "UETD chip registry index",
  "type": "object",
  "required": [
    "schema_version",
    "catalogue_kind",
    "canonical_owner",
    "record_policy",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalogue_kind": {
      "const": "uetd_chip_records"
    },
    "canonical_owner": {
      "const": "UETD"
    },
    "record_policy": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^registry/targets/chips/manifest/[a-z0-9-]+/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  }
}
