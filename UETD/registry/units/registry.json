  "unit_expression_rules": {
    "product": "dimension exponents add and exact scales multiply",
    "quotient": "dimension exponents subtract and exact scales divide",
    "power": "integer exponents multiply dimension exponents and raise exact scales",
    "affine": "affine units such as degC may appear only as standalone temperature values; absolute + absolute and affine products are invalid; subtracting absolute temperatures yields a temperature difference",
    "conversion": "explicit convert_unit<TARGET_UNIT>(value) applies source/target scales and offsets, checks finite/range policy, and never changes the underlying scalar representation implicitly",
    "runtime_conversion": "must be explicit; implicit conversions are errors",
    "literal_conversion": "may be folded at compile time from exact decimal or rational-times-pi scales"
  },
