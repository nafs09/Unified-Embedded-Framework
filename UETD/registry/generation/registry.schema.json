{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uetd.local/registry/generation-catalogue-1.0.schema.json",
  "title": "UETD first-pass host generation capability requirements",
  "description": "Host pipeline obligations are design-only, generation-blocked and distinct from embedded C module identities.",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "registry_schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "area",
        "title",
        "status",
        "contract_file",
        "generation",
        "reason",
        "priority",
        "phase"
      ],
      "properties": {
        "area": {
          "const": "generation"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "design_only"
        },
        "contract_file": {
          "type": "string",
          "minLength": 1
        },
        "api_outline": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "const": "blocked"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "project_relevance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "priority": {
          "const": "FIRST_PASS"
        },
        "phase": {
          "const": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
