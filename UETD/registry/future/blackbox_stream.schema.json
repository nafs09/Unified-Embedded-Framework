{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uetd.local/registry/future/blackbox-stream-1.0.schema.json",
  "title": "UETD binary blackbox stream plan",
  "type": "object",
  "required": ["stream_id", "schema_version", "firmware_version", "target", "timebase_id", "started_reason", "artifact_sha256", "configuration_sha256", "channels", "queue_capacity_bytes", "storage_stall_budget_us", "overflow_policy"],
  "properties": {
    "stream_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "firmware_version": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["chip_id", "board_id", "hardware_revision"],
      "properties": {
        "chip_id": { "type": "string", "minLength": 1 },
        "board_id": { "type": "string", "minLength": 1 },
        "hardware_revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "timebase_id": { "type": "string", "minLength": 1 },
    "started_reason": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "configuration_sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "calibration_revision": { "type": "string" },
    "queue_capacity_bytes": { "type": "integer", "minimum": 1 },
    "storage_stall_budget_us": { "type": "integer", "minimum": 0 },
    "burst_margin_bytes": { "type": "integer", "minimum": 0 },
    "minimum_sustained_write_bytes_per_s": { "type": "number", "exclusiveMinimum": 0 },
    "estimated_production_bytes_per_s": { "type": "number", "exclusiveMinimum": 0 },
    "framing_overhead_bytes_per_s": { "type": "number", "minimum": 0 },
    "retention_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "overflow_policy": { "enum": ["drop_newest", "drop_oldest", "decimate", "stop_on_full"] },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "units", "rate_hz", "max_encoded_bytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "units": { "type": "string", "minLength": 1 },
          "rate_hz": { "type": "number", "exclusiveMinimum": 0 },
          "max_encoded_bytes": { "type": "integer", "minimum": 1 },
          "event_source": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
