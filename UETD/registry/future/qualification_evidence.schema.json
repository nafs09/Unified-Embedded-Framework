{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uetd.local/registry/future/qualification-evidence-1.0.schema.json",
  "title": "UETD capability qualification evidence record",
  "type": "object",
  "required": ["evidence_id", "claim_id", "class", "outcome", "artifact_sha256", "target", "configuration_sha256", "toolchain", "harness", "executed_at_utc", "tests"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "class": { "enum": ["schema_reviewed", "host_tested", "target_built", "target_exercised", "system_hil", "safety_assessed", "security_assessed"] },
    "outcome": { "enum": ["pass", "pass_with_limits", "fail", "inconclusive"] },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "capability_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "target": {
      "type": "object",
      "required": ["chip_id", "board_id", "hardware_revision"],
      "properties": {
        "chip_id": { "type": "string", "minLength": 1 },
        "board_id": { "type": "string", "minLength": 1 },
        "hardware_revision": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string" },
        "external_artifact_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": ["id", "version", "settings_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "settings_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "raw_data_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "environment": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "executed_at_utc": { "type": "string", "format": "date-time" },
    "owner": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "review_after": { "type": "string", "format": "date" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "inconclusive", "not_run"] },
          "fault_injection": { "type": "string" },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value", "unit"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 },
                "limit": { "type": "number" },
                "statistic": { "enum": ["min", "max", "mean", "p99", "count"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" } },
  "additionalProperties": false
}
