{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uetd.local/registry/future/signed-artifact-manifest-1.0.schema.json",
  "title": "UETD signed firmware compatibility manifest",
  "description": "The canonical signed payload is this top-level object with the detached signature property omitted. Implementations must enforce canonical encoding, domain separation, key allow-lists, non-overlapping ranges, and checked address/length arithmetic.",
  "type": "object",
  "required": ["format", "canonicalization", "artifact_schema", "project_id", "firmware_version", "security_index", "targets", "bootloader", "segments", "update_policy", "signature"],
  "properties": {
    "format": { "const": "UETD-SIGNED-IMAGE-1" },
    "canonicalization": { "type": "string", "minLength": 1, "description": "Versioned canonical encoding used for the signed bytes after omission of the detached signature envelope." },
    "artifact_schema": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "firmware_version": { "type": "string", "minLength": 1 },
    "security_index": { "type": "integer", "minimum": 0 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chip_id", "chip_sha256", "board_ids"],
        "properties": {
          "chip_id": { "type": "string", "minLength": 1 },
          "chip_sha256": { "$ref": "#/$defs/sha256" },
          "board_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "hardware_revision_min": { "type": "string" },
          "hardware_revision_max": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "bootloader": {
      "type": "object",
      "required": ["minimum_version"],
      "properties": {
        "minimum_version": { "type": "string", "minLength": 1 },
        "maximum_version": { "type": "string" },
        "required_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "payload_offset", "start_addr", "length", "sha256", "image_format"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "payload_offset": { "type": "integer", "minimum": 0 },
          "start_addr": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "image_format": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "update_policy": {
      "type": "object",
      "required": ["recovery_required", "anti_rollback_required", "trial_health_window_ms"],
      "properties": {
        "recovery_required": { "type": "boolean" },
        "anti_rollback_required": { "type": "boolean" },
        "trial_health_window_ms": { "type": "integer", "minimum": 0 },
        "encryption": { "enum": ["none", "transport", "artifact"] },
        "required_bootloader_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "signature": {
      "description": "Detached signature envelope, excluded from the canonical signed payload.",
      "type": "object",
      "required": ["algorithm", "key_id", "signature_encoding", "signature"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "signature_encoding": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "contentEncoding": "base64" }
      },
      "additionalProperties": false
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" } },
  "additionalProperties": false
}
