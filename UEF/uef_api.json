{
  "schema_version": "1.0",
  "uef_version": "1.1.0",
  "module_registry": "registry/modules/registry.json",
  "ucon_api": {
    "catalogue_manifest": "registry/control_ir/registry.json",
    "status_header": "uef/ucon/ucon_status.h",
    "scaffold_header": "uef/ucon/detail/algorithm_call.h",
    "scaffold_tree": {
      "initial_headers_root": "include/uef/ucon",
      "initial_sources_root": "src/ucon",
      "future_headers_root": "include/uef/ucon/future",
      "future_sources_root": "src/ucon/future",
      "one_algorithm_per_header_and_source": true,
      "first_pass_template_scaffold_root": "templates/ucon/first_pass",
      "first_pass_template_scaffolds_are_todo_only": true,
      "generator": "tools/generate_ucon_scaffolds.py",
      "future_policy": "Unselected PLANNED and all DEFERRED entries are repository-only and not selectable by uef-gen",
      "initial_planned_algorithms": [
        "ADAPTIVE_BS",
        "BACKSTEPPING",
        "BESSEL",
        "BEZIER_TRAJ",
        "BSPLINE_TRAJ",
        "BUTTERWORTH",
        "CBF_QP",
        "CHEBYSHEV1",
        "CHEBYSHEV2",
        "CKF",
        "CLF_CBF",
        "CLF_QP",
        "DDP",
        "DEADBEAT_MPC",
        "ECONOMIC_MPC",
        "ELLIPTIC",
        "EXTREMUM_SEEK",
        "FEEDBACK_LIN",
        "FIR_WINDOWED",
        "FLATNESS",
        "ILQR",
        "INDI2",
        "ITERATED_EKF",
        "MHE",
        "PARTICLE",
        "PID_AUTOTUNE",
        "PKPD_TARGET_CONTROL",
        "REFERENCE_GOVERNOR",
        "ROBUST_MPC",
        "SPARSE_MPC",
        "SQRT_EKF",
        "SQRT_UKF",
        "STOCHASTIC_MPC",
        "ZONE_MPC"
      ]
    },
    "registered_algorithms": {
      "PID": {
        "header": "uef/ucon/control/pid.h",
        "functions": [
          "ucon_pid_init",
          "ucon_pid_reset",
          "ucon_pid_step"
        ]
      },
      "LEAD_LAG": {
        "header": "uef/ucon/control/lead_lag.h",
        "functions": [
          "ucon_lead_lag_init",
          "ucon_lead_lag_reset",
          "ucon_lead_lag_step"
        ]
      }
    },
    "unregistered_policy": "Scaffold functions return UCON_NOT_IMPLEMENTED and never alter state or output buffers.",
    "per_algorithm_operation_functions": true,
    "operation_todos_are_function_scoped": true
  },
