  "selection_groups": {
    "uhal": {
      "selection": "exactly_one",
      "selector": "target",
      "options": {
        "HOST": "uhal/x86",
        "CORTEX_M": "uhal/arm_cm"
      }
    },
    "uos": {
      "selection": "exactly_one",
      "selector": "uos_backend",
      "options": {
        "BAREMETAL": "uos/baremetal",
        "FREERTOS": "uos/freertos"
      }
    }
  },
  "external_dependencies": {
    "fatfs": {
      "provider": "consumer",
      "optional": true,
      "required_by": [
        "umid/fatfs"
      ],
      "headers": [
        "ff.h",
        "diskio.h"
      ],
      "cmake_option": "UEF_ENABLE_FATFS",
      "include_directory_variable": "UEF_FATFS_INCLUDE_DIR",
      "notes": "UEF provides the SDMMC diskio adapter; the FatFS implementation and configuration remain consumer supplied."
    }
  },
