{
  "schema_version": "1.0",
  "catalogue_kind": "uef_target_family_roadmap",
  "canonical_owner": "UEF",
  "description": "Family-level discovery and staged target roadmap; not an exact-chip database.",
  "selection_rules": {
    "catalogue_entry_is_chip_spec": false,
    "family_name_is_generation_target": false,
    "generation_available_for_catalogue_entries": false,
    "verified_hardware_data": false,
    "exact_part_resources_included": false,
    "representative_parts_are_nonbinding_examples": true,
    "exact_part_record_requirements": [
      "vendor datasheet and reference-manual revision",
      "orderable part and package pinout",
      "peripherals, clocks/resets, alternate functions",
      "DMA routing and interrupt names",
      "memory, startup, linker, MPU/cache, and errata",
      "vendor citations and verification record"
    ]
  },
  "roadmap_phase_meaning": {
    "0": "Initial family scaffold, not exact-part support.",
    "1": "Initial-release extension, not exact-part support.",
    "2": "Later target named in UEF specification.",
    "3": "Later target named in UEF specification.",
    "4": "Later target named in UEF specification.",
    "null": "Catalogue coverage only; no phase assigned by current specification."
  },
