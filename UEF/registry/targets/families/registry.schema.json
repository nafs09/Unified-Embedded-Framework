{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uef/registry/targets/families/registry.schema.json",
  "title": "UEF target family registry index",
  "type": "object",
  "required": [
    "schema_version",
    "catalogue_kind",
    "canonical_owner",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalogue_kind": {
      "const": "uef_target_family_roadmap"
    },
    "canonical_owner": {
      "const": "UEF"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^registry/targets/families/manifest/[a-z0-9-]+/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  }
}
