{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/uef-gen-project-1.0.schema.json",
  "title": "uef-gen hardware project configuration",
  "type": "object",
  "required": [
    "target"
  ],
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "chip"
          ]
        },
        {
          "required": [
            "development_board"
          ]
        }
      ],
      "properties": {
        "chip": {
          "type": "string",
          "minLength": 1
        },
        "development_board": {
          "type": "string",
          "minLength": 1,
          "description": "UETD development-board ID. If chip is omitted, the selected board supplies it."
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "description": "Optional toolchain override; otherwise use resolved target.hardware.build.toolchain or its board-preset default."
        },
        "arithmetic": {
          "enum": [
            "float32",
            "float64",
            "q15",
            "q31",
            "custom"
          ]
        },
        "rtos": {
          "type": "string",
          "minLength": 1
        },
        "freertos": {
          "type": "object",
          "properties": {
            "tick_hz": {
              "type": "integer",
              "minimum": 1
            },
            "static_allocation": {
              "type": "boolean"
            },
            "heap_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "hardware": {
          "type": "object",
          "properties": {
            "clock_sources": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "memory_regions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "origin",
                  "length_bytes"
                ],
                "properties": {
                  "origin": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "length_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "kind": {
                    "type": "string"
                  },
                  "dma_accessible": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "address_space": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Explicit address space, e.g. program/data for Harvard targets; defaults to unified."
                  }
                },
                "additionalProperties": false
              }
            },
            "reserved_pins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "module": {
              "type": "object",
              "description": "Optional module details live with the board record; no separate module catalogue is needed.",
              "properties": {
                "name": {
                  "type": "string"
                },
                "variant": {
                  "type": "string"
                },
                "flash_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "psram_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "crystal_hz": {
                  "type": "integer",
                  "minimum": 0
                },
                "antenna": {
                  "type": "string"
                },
                "exposed_pins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": true
            },
            "build": {
              "type": "object",
              "description": "Target compiler/SDK adapter and pinned UETD toolchain; independent of board selection.",
              "properties": {
                "backend": {
                  "type": "string",
                  "minLength": 1
                },
                "framework": {
                  "type": "string"
                },
                "toolchain": {
                  "type": "string",
                  "minLength": 1
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "backend",
                "toolchain"
              ],
              "additionalProperties": true
            },
            "flash": {
              "type": "object",
              "description": "Target programming adapter, toolchain and transport settings; required by flashing, not compilation.",
              "properties": {
                "backend": {
                  "type": "string",
                  "minLength": 1
                },
                "toolchain": {
                  "type": "string",
                  "minLength": 1
                },
                "interface": {
                  "type": "string"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "backend",
                "toolchain"
              ],
              "additionalProperties": true
            },
            "debug_console": {
              "type": "object",
              "description": "Optional wired V1 live-output endpoint. Port names are selected on the host at runtime; baud/framing belong to the board record.",
              "required": [
                "transport",
                "baud_rate",
                "data_bits",
                "parity",
                "stop_bits",
                "encoding"
              ],
              "properties": {
                "transport": {
                  "enum": [
                    "usb_cdc",
                    "usb_uart"
                  ]
                },
                "baud_rate": {
                  "type": "integer",
                  "minimum": 1
                },
                "data_bits": {
                  "enum": [
                    7,
                    8
                  ]
                },
                "parity": {
                  "enum": [
                    "none",
                    "even",
                    "odd"
                  ]
                },
                "stop_bits": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "encoding": {
                  "type": "string",
                  "minLength": 1
                },
                "line_ending": {
                  "enum": [
                    "lf",
                    "crlf",
                    "cr",
                    "none"
                  ]
                },
                "dtr": {
                  "type": "boolean",
                  "default": false
                },
                "rts": {
                  "type": "boolean",
                  "default": false
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "Physical target and build/programming settings for a bare chip or custom assembly; optional board settings provide defaults."
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "protocols": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "peripherals": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peripheral"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/peripheralConfig"
          }
        }
      ]
    },
    "clock": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "domain",
              "frequency_hz"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "frequency_hz": {
                "type": "integer",
                "minimum": 1
              },
              "tolerance_ppm": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "properties": {
        "flash_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "main_stack_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "heap_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "rtos": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "tick_us": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "tasks": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/task"
          }
        }
      ]
    },
    "middleware": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "boolean"
        ]
      }
    },
    "uetd": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "extra_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "defines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(=.*)?$"
      }
    },
    "compiler_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "period_us": {
          "type": "integer",
          "minimum": 1
        },
        "rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "context": {
          "enum": [
            "isr",
            "task"
          ]
        },
        "execution_context": {
          "type": "string"
        },
        "isr_source": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "stack_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "period_us"
          ]
        },
        {
          "required": [
            "rate_hz"
          ]
        }
      ],
      "additionalProperties": true
    },
    "peripheralConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dma": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "irq_priority": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "peripheral": {
      "allOf": [
        {
          "$ref": "#/$defs/peripheralConfig"
        },
        {
          "type": "object",
          "required": [
            "instance"
          ],
          "properties": {
            "instance": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
