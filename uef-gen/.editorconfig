root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{cmake,txt}]
indent_style = space
indent_size = 2
tab_width = 2
