{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS to uef-gen request",
  "type": "object",
  "required": ["contract_version", "operation", "hardware_configuration", "output_directory", "work_directory"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "operation": {"const": "generate"},
    "hardware_configuration": {"$ref": "project.schema.json"},
    "control_ir": {"$ref": "control_ir.schema.json"},
    "output_directory": {"type": "string"},
    "work_directory": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
