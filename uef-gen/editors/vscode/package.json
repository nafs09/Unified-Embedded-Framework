{
  "name": "uef-project-language",
  "displayName": "UEF Project Language",
  "description": "UEF-PL authoring tools: compiler diagnostics, navigation, formatting, live UETD intelligence, and coordinated dark and light themes.",
  "version": "0.1.5",
  "publisher": "uef",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nafs09/Unified-Embedded-Framework.git",
    "directory": "uef-gen/editors/vscode"
  },
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.91.0"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:uef-project",
    "onLanguage:uef-system"
  ],
  "contributes": {
    "languages": [
      {
        "id": "uef-project",
        "aliases": [
          "UEF Project",
          "UEF-PL"
        ],
        "extensions": [
          ".uef"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uef-system",
        "aliases": [
          "UEF System",
          "UEF-PL System"
        ],
        "extensions": [
          ".uefs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uef-project",
        "scopeName": "source.uef-project",
        "path": "./syntaxes/uef.tmLanguage.json"
      },
      {
        "language": "uef-system",
        "scopeName": "source.uef-system",
        "path": "./syntaxes/uefs.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "UEF-PL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/uef-pl-dark-color-theme.json"
      },
      {
        "label": "UEF-PL Light",
        "uiTheme": "vs",
        "path": "./themes/uef-pl-light-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "uef-project",
        "path": "./snippets/uef.json"
      },
      {
        "language": "uef-system",
        "path": "./snippets/uefs.json"
      }
    ],
    "configuration": {
      "title": "UEF Project Language",
      "properties": {
        "uef-project-language.uefRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the UETD checkout. Leave blank to discover it from the current workspace."
        },
        "uef-project-language.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the shared uef-gen language server. Install uef-gen with its language-server extra first; set false to use registry hints without compiler diagnostics."
        },
        "uef-project-language.languageServer.executable": {
          "type": "string",
          "default": "",
          "description": "Optional server executable path. If it is unavailable, the extension tries the PATH entry point and then the Python module launcher."
        },
        "uef-project-language.languageServer.pythonExecutable": {
          "type": "string",
          "default": "python",
          "description": "Python executable used as a fallback with -m uef_gen.language.server. Use the interpreter where uef-gen[language-server] is installed."
        },
        "uef-project-language.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments passed to the language server."
        }
      }
    },
    "commands": [
      {
        "command": "uef-project-language.showActions",
        "title": "Source Tools",
        "category": "UEF-PL"
      },
      {
        "command": "uef-project-language.restartServer",
        "title": "Restart Language Server",
        "category": "UEF-PL"
      },
      {
        "command": "uef-project-language.showOutput",
        "title": "Show Server Output",
        "category": "UEF-PL"
      },
      {
        "command": "uef-project-language.openSettings",
        "title": "Open Settings",
        "category": "UEF-PL"
      }
    ],
    "configurationDefaults": {
      "[uef-project]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "uef.uef-project-language"
      },
      "[uef-system]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "uef.uef-project-language"
      }
    },
    "semanticTokenTypes": [
      {
        "id": "unit",
        "superType": "number",
        "description": "UEF-PL unit"
      },
      {
        "id": "projectKeyword",
        "superType": "keyword",
        "description": "UEF-PL projectKeyword"
      },
      {
        "id": "typeKeyword",
        "superType": "keyword",
        "description": "UEF-PL typeKeyword"
      },
      {
        "id": "hardwareKeyword",
        "superType": "keyword",
        "description": "UEF-PL hardwareKeyword"
      },
      {
        "id": "algorithmKeyword",
        "superType": "keyword",
        "description": "UEF-PL algorithmKeyword"
      },
      {
        "id": "runtimeKeyword",
        "superType": "keyword",
        "description": "UEF-PL runtimeKeyword"
      },
      {
        "id": "bindingKeyword",
        "superType": "keyword",
        "description": "UEF-PL bindingKeyword"
      },
      {
        "id": "flowKeyword",
        "superType": "keyword",
        "description": "UEF-PL flowKeyword"
      },
      {
        "id": "projectName",
        "superType": "namespace",
        "description": "UEF-PL projectName"
      },
      {
        "id": "hardwareName",
        "superType": "variable",
        "description": "UEF-PL hardwareName"
      },
      {
        "id": "algorithmName",
        "superType": "function",
        "description": "UEF-PL algorithmName"
      },
      {
        "id": "runtimeName",
        "superType": "namespace",
        "description": "UEF-PL runtimeName"
      },
      {
        "id": "typeName",
        "superType": "type",
        "description": "UEF-PL typeName"
      },
      {
        "id": "recordField",
        "superType": "property",
        "description": "UEF-PL recordField"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
