{
  "$schema": "vscode://schemas/color-theme",
  "name": "UEF-PL Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101820",
    "editor.foreground": "#D6E2EA",
    "editorLineNumber.foreground": "#647787",
    "editorLineNumber.activeForeground": "#C4D7E3",
    "editor.selectionBackground": "#274D64",
    "editor.inactiveSelectionBackground": "#233847",
    "editor.lineHighlightBackground": "#16222D",
    "editorCursor.foreground": "#6DD4C4",
    "editorIndentGuide.background1": "#263642",
    "editorIndentGuide.activeBackground1": "#55768B",
    "editorWhitespace.foreground": "#354956",
    "editorBracketMatch.background": "#21453F",
    "editorBracketMatch.border": "#6DD4C4",
    "editorError.foreground": "#F38D91",
    "editorWarning.foreground": "#E5C477",
    "editorInfo.foreground": "#7CC7F2",
    "sideBar.background": "#131E28",
    "sideBar.foreground": "#AFBFCC",
    "activityBar.background": "#0D141C",
    "activityBar.foreground": "#6DD4C4",
    "activityBarBadge.background": "#6DD4C4",
    "activityBarBadge.foreground": "#101820",
    "statusBar.background": "#152B35",
    "statusBar.foreground": "#C4E2E9",
    "statusBar.noFolderBackground": "#152B35",
    "titleBar.activeBackground": "#0D141C",
    "titleBar.activeForeground": "#D6E2EA",
    "tab.activeBackground": "#101820",
    "tab.inactiveBackground": "#16222D",
    "tab.activeBorderTop": "#6DD4C4",
    "editorGroupHeader.tabsBackground": "#0D141C",
    "panel.background": "#131E28",
    "panel.border": "#263642",
    "input.background": "#1B2B38",
    "input.foreground": "#D6E2EA",
    "input.border": "#354956",
    "focusBorder": "#6DD4C4",
    "button.background": "#28776C",
    "button.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#274D64",
    "list.hoverBackground": "#1C303E"
  },
  "tokenColors": [
    {
      "scope": [
        "comment.line.number-sign.uef-project",
        "comment.line.double-slash.uef-project",
        "comment.line.number-sign.uef-system",
        "comment.line.double-slash.uef-system"
      ],
      "settings": {
        "foreground": "#8C9FAE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.quoted.double.uef-project",
        "string.quoted.single.uef-project",
        "string.quoted.double.uef-system",
        "string.quoted.single.uef-system"
      ],
      "settings": {
        "foreground": "#E9BD91"
      }
    },
    {
      "scope": [
        "constant.character.escape.uef-project",
        "constant.character.escape.uef-system"
      ],
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "scope": [
        "constant.numeric.uef-project",
        "constant.numeric.uef-system"
      ],
      "settings": {
        "foreground": "#E5D69E"
      }
    },
    {
      "scope": [
        "constant.numeric.type-dimension.uef-project",
        "constant.numeric.type-dimension.uef-system"
      ],
      "settings": {
        "foreground": "#E5D69E"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.uef-project",
        "keyword.control.declaration.uef-system",
        "keyword.control.system.uef-system"
      ],
      "settings": {
        "foreground": "#88B4EE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.project.uef-project",
        "keyword.control.declaration.project.uef-system"
      ],
      "settings": {
        "foreground": "#7CC7F2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.type.uef-project",
        "keyword.control.declaration.type.uef-system"
      ],
      "settings": {
        "foreground": "#6DD4C4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.hardware.uef-project",
        "keyword.control.declaration.hardware.uef-system"
      ],
      "settings": {
        "foreground": "#F2AC83",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.algorithm.uef-project",
        "keyword.control.declaration.algorithm.uef-system"
      ],
      "settings": {
        "foreground": "#C4ABF4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.runtime.uef-project",
        "keyword.control.declaration.runtime.uef-system"
      ],
      "settings": {
        "foreground": "#A8D88D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.declaration.binding.uef-project",
        "keyword.control.declaration.binding.uef-system"
      ],
      "settings": {
        "foreground": "#88B4EE"
      }
    },
    {
      "scope": [
        "entity.name.declaration.project.uef-project",
        "entity.name.declaration.project.uef-system"
      ],
      "settings": {
        "foreground": "#9BD8FA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.declaration.hardware.uef-project",
        "entity.name.declaration.hardware.uef-system"
      ],
      "settings": {
        "foreground": "#F4C19E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.declaration.algorithm.uef-project",
        "entity.name.declaration.algorithm.uef-system"
      ],
      "settings": {
        "foreground": "#D6BEFA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.declaration.runtime.uef-project",
        "entity.name.declaration.runtime.uef-system"
      ],
      "settings": {
        "foreground": "#C0E6AC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.declaration.type.uef-project",
        "entity.name.declaration.type.uef-system"
      ],
      "settings": {
        "foreground": "#93E3D4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.other.enum-member.uef-project",
        "constant.other.enum-member.uef-system",
        "constant.other.enum-case.uef-project",
        "constant.other.enum-case.uef-system"
      ],
      "settings": {
        "foreground": "#C4ABF4"
      }
    },
    {
      "scope": [
        "variable.other.field.uef-project",
        "variable.other.field.uef-system"
      ],
      "settings": {
        "foreground": "#AFD5E9"
      }
    },
    {
      "scope": [
        "keyword.control.flow.uef-project",
        "keyword.control.flow.uef-system",
        "storage.modifier.uef-project"
      ],
      "settings": {
        "foreground": "#C4ABF4"
      }
    },
    {
      "scope": [
        "storage.type.uef-project",
        "storage.type.uef-system",
        "support.type.uef-project",
        "support.type.uef-system"
      ],
      "settings": {
        "foreground": "#6DD4C4"
      }
    },
    {
      "scope": [
        "entity.name.type.uef-project",
        "entity.name.type.uef-system",
        "entity.name.type.enum.uef-project",
        "entity.name.type.record.uef-project",
        "entity.name.type.state.uef-project"
      ],
      "settings": {
        "foreground": "#6DD4C4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type.registered.uef-project",
        "entity.name.type.registered.uef-system"
      ],
      "settings": {
        "foreground": "#7CC7F2"
      }
    },
    {
      "scope": [
        "entity.name.function.uef-project",
        "entity.name.function.uef-system",
        "support.function.builtin.uef-project",
        "support.function.builtin.uef-system"
      ],
      "settings": {
        "foreground": "#E5D69E"
      }
    },
    {
      "scope": [
        "constant.other.enum-case.uef-project",
        "constant.other.enum-case.uef-system"
      ],
      "settings": {
        "foreground": "#C4ABF4"
      }
    },
    {
      "scope": [
        "variable.other.property.uef-project",
        "variable.other.property.uef-system",
        "entity.name.variable.uef-project",
        "entity.name.variable.uef-system"
      ],
      "settings": {
        "foreground": "#AFD5E9"
      }
    },
    {
      "scope": [
        "keyword.other.unit.uef-project",
        "keyword.other.unit.uef-system"
      ],
      "settings": {
        "foreground": "#B9D791"
      }
    },
    {
      "scope": [
        "keyword.operator.uef-project",
        "keyword.operator.uef-system",
        "punctuation.section.block.uef-project",
        "punctuation.section.block.uef-system"
      ],
      "settings": {
        "foreground": "#D6E2EA"
      }
    },
    {
      "scope": [
        "constant.language.uef-project",
        "constant.language.uef-system"
      ],
      "settings": {
        "foreground": "#88B4EE"
      }
    },
    {
      "scope": [
        "variable.other.uef-project",
        "variable.other.uef-system",
        "entity.name.uef-project",
        "entity.name.uef-system"
      ],
      "settings": {
        "foreground": "#D6E2EA"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7CC7F2",
    "type": "#6DD4C4",
    "class": "#7CC7F2",
    "function": "#E5D69E",
    "unit": "#B9D791",
    "enumMember": "#C4ABF4",
    "property": "#AFD5E9",
    "variable": "#D6E2EA",
    "parameter": "#AFD5E9",
    "keyword": "#88B4EE",
    "projectKeyword": {
      "foreground": "#7CC7F2",
      "bold": true
    },
    "typeKeyword": {
      "foreground": "#6DD4C4",
      "bold": true
    },
    "hardwareKeyword": {
      "foreground": "#F2AC83",
      "bold": true
    },
    "algorithmKeyword": {
      "foreground": "#C4ABF4",
      "bold": true
    },
    "runtimeKeyword": {
      "foreground": "#A8D88D",
      "bold": true
    },
    "bindingKeyword": "#88B4EE",
    "flowKeyword": "#C4ABF4",
    "projectName": {
      "foreground": "#9BD8FA",
      "bold": true
    },
    "hardwareName": {
      "foreground": "#F4C19E",
      "bold": true
    },
    "algorithmName": {
      "foreground": "#D6BEFA",
      "bold": true
    },
    "runtimeName": {
      "foreground": "#C0E6AC",
      "bold": true
    },
    "typeName": {
      "foreground": "#93E3D4",
      "bold": true
    },
    "recordField": "#AFD5E9",
    "operator": "#D6E2EA",
    "number": "#E5D69E",
    "string": "#E9BD91"
  },
  "semanticHighlighting": true
}
