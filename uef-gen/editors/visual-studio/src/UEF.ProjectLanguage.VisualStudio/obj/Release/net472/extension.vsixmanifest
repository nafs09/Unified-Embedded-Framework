<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="UEF.ProjectLanguage.VisualStudio" Version="0.1.13" Language="en-US" Publisher="Unified Embedded Framework" />
    <DisplayName>UEF Project Language</DisplayName>
    <Description xml:space="preserve">Language file support and LSP client scaffold for UEF-PL .uef and .uefs projects.</Description>
    <Tags>UETD;embedded;language;LSP</Tags>
  </Metadata>
  <Installation>
    <!-- The VS 17.x API surface is compatible with VS2022 and VS2026. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies />
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" />
  </Prerequisites>
  <Assets>
    <!-- Register the actual shipped assembly path. The project-source asset was
         being reduced to a pathless MEF asset in the SDK-style package, so VS
         installed the DLL without indexing its ILanguageClient exports. -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="UEF.ProjectLanguage.VisualStudio.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="UEF-PL.pkgdef" />
  </Assets>
</PackageManifest>